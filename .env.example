# Kopieer naar .env en pas aan:  cp .env.example .env

# --- Database ---
POSTGRES_USER=filament
POSTGRES_PASSWORD=verander-mij
POSTGRES_DB=filament

# --- Webinterface ---
# Poort op de host waarop de app bereikbaar is
APP_PORT=8080
APP_TITLE=Filament Manager

# --- Gedrag ---
# Beschikbare materialen (kommagescheiden, uitbreidbaar, bv. PLA,PETG,ABS,ASA,TPU,PA)
MATERIALS=PLA,PETG,ABS,ASA
# Drempel in procent waaronder een spoel als "bijna op" wordt gemarkeerd
LOW_STOCK_THRESHOLD=15
# Standaardgewicht (gram) van een nieuwe spoel in het formulier
DEFAULT_WEIGHT_NEW=1000
# Voorbeeldspoelen toevoegen bij de eerste start (alleen als de database leeg is)
SEED_DEMO=false

# Tijdzone voor weergave van datums
TZ=Europe/Amsterdam
